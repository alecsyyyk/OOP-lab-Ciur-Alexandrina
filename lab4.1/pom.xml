<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.lab4</groupId>
    <artifactId>lab4.1</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Lab 4.1 - Intermediate Tasks</name>
    <description>OOP Lab - Display Comparison and Text Analysis</description>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <sourceDirectory>${project.basedir}</sourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>17</source>
                    <target>17</target>
                    <includes>
                        <include>task1/**/*.java</include>
                        <include>task2/**/*.java</include>
                        <include>task3/**/*.java</include>
                        <include>task4/**/*.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <!-- Default: Task 1 - Display Comparison -->
                    <execution>
                        <id>default</id>
                        <configuration>
                            <mainClass>task1.Display</mainClass>
                        </configuration>
                    </execution>
                    <!-- Task 1: Display Comparison -->
                    <execution>
                        <id>task1</id>
                        <configuration>
                            <mainClass>task1.Display</mainClass>
                        </configuration>
                    </execution>
                    <!-- Task 2: Text Analysis -->
                    <execution>
                        <id>task2</id>
                        <configuration>
                            <mainClass>task2.Main</mainClass>
                            <arguments>
                                <argument>task2/text.txt</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!-- Task 3: Assistant -->
                    <execution>
                        <id>task3</id>
                        <configuration>
                            <mainClass>task3.Main</mainClass>
                        </configuration>
                    </execution>
                    <!-- Task 4: Multiple Files Analysis -->
                    <execution>
                        <id>task4</id>
                        <configuration>
                            <mainClass>task4.Main</mainClass>
                            <arguments>
                                <argument>task4/file1.txt</argument>
                                <argument>task4/file2.txt</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
